# GEMINI_API_KEY: Optional if AI extensions are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CLOUD DATABASE & STORAGE CONFIGURATION (Free Tier)
# ==============================================================================
# Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=
# Supabase Anon Public Key
SUPABASE_ANON_KEY=
# Supabase Service Role Key (for secure server-side database & storage operations)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Storage Bucket for encrypted/analyzed file artifacts (Default: "qsecure-files")
SUPABASE_BUCKET=qsecure-files

# ==============================================================================
# PERSISTENT STORAGE / POSTGRESQL CONFIGURATION
# ==============================================================================
# PostgreSQL Connection URL (e.g. postgresql://user:password@localhost:5432/qshield)
# When unset or if PostgreSQL is unreachable, the system automatically uses robust
# local JSON/file-based persistent storage so the service never crashes.
DATABASE_URL=

# JSON Web Token Secret for Forensic Authentication & Audit Signatures
JWT_SECRET=qshield_research_laboratory_jwt_secret_key_2026

# ==============================================================================
# AUTOMATIC EMAIL ALERT & FORENSIC NOTIFICATION CONFIGURATION
# ==============================================================================
# Security Administrator / System Owner Email Address to receive critical alerts
OWNER_EMAIL="deepakmurugaiyan@gmail.com"

# Outgoing SMTP Authentication Credentials (e.g., Google Workspace / Gmail App Password)
SMTP_EMAIL="alerts-noreply@example.com"
SMTP_PASSWORD="your-smtp-app-password"

# Outgoing SMTP Server and Port (e.g. smtp.gmail.com with TLS port 587 or SSL port 465)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587

# EMAIL_TEST_MODE: Set to True for development/demo (simulates email without sending)
# Set to False in production to transmit real SMTP email alerts
EMAIL_TEST_MODE=True

# Application Server Port
PORT=5000

# ==============================================================================
# LARGE FILE STREAMING & UPLOAD CONFIGURATION (Up to 1 TB)
# ==============================================================================
# Maximum allowed file upload size in bytes (Default: 1 TB = 1099511627776)
MAX_UPLOAD_SIZE=1099511627776

# Upload streaming chunk size in bytes (Default: 1 MB = 1048576)
UPLOAD_CHUNK_SIZE=1048576
